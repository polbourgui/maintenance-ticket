# Copy to .env and adjust. Every variable is prefixed with APP_.
APP_ENVIRONMENT=development            # development | test | production
# REQUIRED - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-change-me-change-me-change-me
APP_DATABASE_URL=sqlite:///./maintenance.db
# APP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/maintenance
APP_DOCS_ENABLED=true
APP_CORS_ORIGINS=[]                    # JSON list, e.g. ["https://maintenance.example.org"]

# Sessions
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_WINDOW_SECONDS=300

# Uploads
APP_UPLOAD_DIR=./var/uploads
APP_MAX_UPLOAD_BYTES=10485760

# Notifications (no channel configured => notifications are logged)
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_STARTTLS=true
APP_SMTP_FROM=maintenance@example.org
APP_DISCORD_WEBHOOK_URL=               # https://discord.com/api/webhooks/<id>/<token>
